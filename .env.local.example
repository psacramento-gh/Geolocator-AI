# MoneyDevKit credentials
# Get these from https://moneydevkit.com/dashboard or run: npx @moneydevkit/create
MDK_ACCESS_TOKEN=your_mdk_api_key_here
MDK_MNEMONIC=your_mdk_mnemonic_here

# Google Gemini API key
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional additional vision providers
OPENAI_API_KEY=
QWEN_API_KEY=

# Admin area (/admin) — never expose to the browser
ADMIN_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Vercel Blob (benchmark images only)
BLOB_READ_WRITE_TOKEN=
