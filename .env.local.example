# MoneyDevKit credentials
# Get these from https://moneydevkit.com/dashboard or run: npx @moneydevkit/create
MDK_ACCESS_TOKEN=your_mdk_api_key_here
MDK_MNEMONIC=your_mdk_mnemonic_here

# Vercel AI Gateway (preferred on Vercel: OIDC via `vercel env pull`)
# On Vercel deployments, OIDC is automatic after AI Gateway is enabled for the project.
# For local/CI without OIDC, set a server-side Gateway key:
AI_GATEWAY_API_KEY=

# Admin area (/admin) — never expose to the browser
ADMIN_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Vercel Blob (benchmark images only)
BLOB_READ_WRITE_TOKEN=

# Optional legacy provider keys — remove after Gateway production verification
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# QWEN_API_KEY=
