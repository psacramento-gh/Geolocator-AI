# Vercel AI Gateway (preferred on Vercel: OIDC via `vercel env pull`)
# On Vercel deployments, OIDC is automatic after AI Gateway is enabled for the project.
# For local/CI without OIDC, set a server-side Gateway key:
AI_GATEWAY_API_KEY=

# Image Gate (pre-inference suitability check via AI Gateway)
# Free-tier vision model preferred for suitability checks (paid id when free ends).
IMAGE_GATE_MODEL=inclusionai/ling-3.0-flash-vl
# When the semantic gate fails (timeout/unavailable), continue to geolocation (default: true)
IMAGE_GATE_FAIL_OPEN=true
# Optional dedicated secret for signed pre-analyze gate passes (falls back to ADMIN_SECRET)
# IMAGE_GATE_PASS_SECRET=

# Admin area (/admin) — never expose to the browser
ADMIN_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Vercel Blob (benchmark images only)
BLOB_READ_WRITE_TOKEN=

# Optional legacy provider keys — remove after Gateway production verification
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# QWEN_API_KEY=
